---
import SEOHead from '../components/SEOHead.astro';

export interface Props {
  title: string;
  description: string;
  schemaJSON?: Record<string, any>;
}

const { title, description, schemaJSON } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEOHead title={title} description={description} schemaJSON={schemaJSON} />
    <style is:global>
      :root {
        --color-bg: #0b0f19;
        --color-text: #f1f5f9;
        --color-primary: #38bdf8;
      }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <header style="padding: 1.5rem 2rem; border-bottom: 1px solid #1e293b; display: flex; justify-content: space-between; align-items: center;">
      <a href="/" style="font-weight: 700; font-size: 1.25rem; color: #38bdf8; text-decoration: none;">Astro E-E-A-T</a>
      <nav>
        <a href="https://github.com/khaledkhalaf1992/astro-eeat-seo-starter" style="color: #94a3b8; text-decoration: none; margin-left: 1.5rem;">GitHub</a>
      </nav>
    </header>
    <main style="max-width: 900px; margin: 0 auto; padding: 3rem 1.5rem;">
      <slot />
    </main>
    <footer style="padding: 3rem 2rem; border-top: 1px solid #1e293b; text-align: center; color: #64748b; font-size: 0.875rem;">
      <p>Built with ❤️ by <a href="https://github.com/khaledkhalaf1992" style="color: #38bdf8; text-decoration: none;">Khaled Gamal Khalaf</a>. Open-source under MIT License.</p>
    </footer>
  </body>
</html>
